#!/bin/bash

# MiProxy 主进程管理脚本
# 启动时自动调用 refresh_sub 守护进程实现定时订阅刷新

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
REFRESH_PID_FILE="${TRIM_PKGVAR}/refresh_sub.pid"
ADMIN_PID_FILE="${TRIM_PKGVAR}/admin.pid"
# 「内核正在重启」标记文件。
# 为什么需要它：fnOS 靠 `main status` 的退出码判断应用生死（0=运行 / 3=停止），
# 换配置必然要重启内核，中间会有几秒内核不在。fnOS 巡检到这一瞬就会把应用
# 标成「已停止」，用户看到的就是「切换订阅后应用直接停止、需要手动启动」。
# 所以重启期间让 status 继续返回 0，等于告诉 fnOS「我还活着，只是内核在换」。
RESTART_FLAG="${TRIM_PKGVAR}/restarting"
MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# MiProxy 核心路径
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"

CMD="${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# ============ 辅助函数 ============

check_process() {
    local pid=$1
    if [ -z "${pid}" ]; then
        return 1
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

is_running() {
    # 检查 PID 文件中的进程是否仍在运行
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        # kill -0 判不出来时别急着删 PID 文件 —— 先看内核的代理端口在不在监听。
        # 内核起来就一定会占着 mixed-port，所以「端口在监听」是比 PID 更可靠的
        # 存活证据：PID 判定可能因为 PID 命名空间差异而误判（本地 Windows 调试
        # 就是 native PID vs MSYS PID），但端口不会骗人。
        if kernel_port_listening; then
            return 0
        fi
        # 清理过期的 PID 文件
        rm -f "${PID_FILE}"
    fi
    return 1
}

# 内核的代理端口是否在监听（比 PID 文件更可靠的存活证据）
kernel_port_listening() {
    local port
    port=$(grep '^wizard_http_port=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
    port="${port:-7890}"
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null
}

# ============ 订阅刷新守护进程管理 ============

# 查找脚本位置（支持多种安装路径）
find_script() {
    local name="$1"
    # 优先尝试 /var/apps/ 路径（飞牛官方 cmd 目录位置）
    if [ -f "/var/apps/miproxy/cmd/${name}" ]; then
        echo "/var/apps/miproxy/cmd/${name}"
        return 0
    fi
    # 尝试 TRIM_PKGVAR 目录
    if [ -f "${TRIM_PKGVAR}/cmd/${name}" ]; then
        echo "${TRIM_PKGVAR}/cmd/${name}"
        return 0
    fi
    # 尝试 TRIM_APPDEST/cmd/ 路径
    if [ -f "${TRIM_APPDEST}/cmd/${name}" ]; then
        echo "${TRIM_APPDEST}/cmd/${name}"
        return 0
    fi
    # 尝试标准安装路径
    for p in "/var/packages/miproxy/cmd/${name}" "${TRIM_APPDEST}/${name}" "${MAIN_DIR}/${name}"; do
        if [ -f "${p}" ]; then
            echo "${p}"
            return 0
        fi
    done
    # 尝试从已知的 cmd 目录
    for p in "/var/apps/miproxy/cmd" "/var/packages/miproxy/cmd" "${TRIM_APPDEST}/cmd" "${TRIM_PKGVAR}/cmd"; do
        if [ -d "${p}" ] && [ -f "${p}/${name}" ]; then
            echo "${p}/${name}"
            return 0
        fi
    done
    return 1
}


start_refresh_daemon() {
    # 检查是否需要启动守护进程
    if [ ! -f "${TRIM_PKGETC}/settings.conf" ]; then
        log_msg "配置文件不存在，跳过订阅刷新守护进程"
        return 0
    fi
    
    local sub_type sub_url refresh_interval
    sub_type=$(grep '^wizard_sub_type=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    
    # 检查是否满足运行条件
    if [ "${sub_type}" != "remote" ]; then
        log_msg "订阅类型为 ${sub_type}，不启动刷新守护进程"
        return 0
    fi
    
    if [ -z "${sub_url}" ]; then
        log_msg "订阅 URL 为空，不启动刷新守护进程"
        return 0
    fi
    
    if [ -z "${refresh_interval}" ] || [ "${refresh_interval}" -le 0 ] 2>/dev/null; then
        log_msg "刷新间隔为 ${refresh_interval} 小时，不启动刷新守护进程"
        return 0
    fi
    
    # 检查守护进程是否已经在运行
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if check_process "${existing_pid}"; then
            log_msg "订阅刷新守护进程已在运行 (PID: ${existing_pid})"
            return 0
        else
            rm -f "${REFRESH_PID_FILE}"
        fi
    fi
    
    # 启动守护进程
    log_msg "启动订阅刷新守护进程 (间隔: ${refresh_interval} 小时)..."
    
    # 守护进程脚本：fnOS 上曾把 refresh_sub 复制到数据目录再执行。
    # 这里每次都跟安装目录比对内容并同步 —— 如果只在“不存在时复制”，
    # 升级 .fpk 更新了 refresh_sub 之后，数据目录里的旧副本会一直生效（升级等于没生）。
    local refresh_sub_script="${TRIM_PKGVAR}/refresh_sub"
    local src_script
    src_script=$(find_script "refresh_sub") || src_script=""
    if [ -n "${src_script}" ] && [ "${src_script}" != "${refresh_sub_script}" ]; then
        if ! cmp -s "${src_script}" "${refresh_sub_script}" 2>/dev/null; then
            cp -f "${src_script}" "${refresh_sub_script}"
            chmod +x "${refresh_sub_script}"
            log_msg "已同步 refresh_sub 到数据目录（来源 ${src_script}）"
        fi
    elif [ ! -f "${refresh_sub_script}" ]; then
        log_msg "错误: 无法找到 refresh_sub 脚本（已尝试 /var/apps、TRIM_APPDEST、TRIM_PKGVAR）"
        return 1
    fi
    
    # 后台运行守护进程
    nohup env TRIM_PKGVAR="${TRIM_PKGVAR}" TRIM_PKGETC="${TRIM_PKGETC}" TRIM_APPDEST="${TRIM_APPDEST}" bash "${refresh_sub_script}" >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    echo "${new_pid}" > "${REFRESH_PID_FILE}"
    
    sleep 1
    if check_process "${new_pid}"; then
        log_msg "订阅刷新守护进程已启动 (PID: ${new_pid})"
    else
        log_msg "警告：订阅刷新守护进程启动失败"
        rm -f "${REFRESH_PID_FILE}"
    fi
}

stop_refresh_daemon() {
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            log_msg "停止订阅刷新守护进程 (PID: ${pid})..."
            kill -TERM "${pid}" >> ${LOG_FILE} 2>&1 || true
            sleep 1
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> ${LOG_FILE} 2>&1 || true
            fi
        fi
        rm -f "${REFRESH_PID_FILE}"
    fi
}

# ============ 内核重启（不牵连管理服务与刷新守护进程）============
#
# 为什么需要单独一套「只重启内核」：
# config_callback 过去用 `main stop` + `main start` 来应用新配置，那会把
# ①刷新守护进程 ②管理服务 ③内核 一起停掉再拉起。后果是：
#   - 停内核到重启完成之间有十几秒窗口，fnOS 靠 `main status` 的退出码
#     （0=运行 / 3=停止）判断应用生死，巡检到就会把应用标成「已停止」，
#     用户看到的就是「切换订阅后应用直接停止、需要手动启动」。
#   - stop/start 还会顺手停掉刷新守护进程，把「订阅刷新」与「切换订阅」
#     变成两件互相打架的事。
# 所以这里提供 restart_kernel：只换内核进程，管理服务与守护进程原地不动。

# 停内核（不含守护进程/管理服务）
stop_kernel_only() {
    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    fi
    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 0
    fi
    log_msg "停止内核 (PID: ${pid})..."
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
        sleep 1
    fi
    rm -f "${PID_FILE}"
    return 0
}

# 启内核（不含守护进程/管理服务）
start_kernel_only() {
    if is_running; then
        log_msg "内核已在运行"
        return 0
    fi
    if [ ! -x "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 二进制不存在或不可执行: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: mihomo 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi
    log_msg "启动内核 (cmd: ${CMD})..."
    # nohup：内核是常驻服务，绝不能随调用方（install_callback / config_callback /
    # restart-kernel 这些瞬态 bash 进程）退出而被 SIGHUP 带走。
    # 否则「切换订阅 → 重启内核」后调用方进程结束，内核会一起死掉，fnOS 巡检到就判
    # 应用停止，用户看到的就是「切换订阅后应用直接停止、需要手动启动」。
    nohup "${MIHOMO_BIN}" -d "${MIHOMO_DIR}" -f "${MIHOMO_CONFIG}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > ${PID_FILE}
    sleep 2
    if check_process "${pid}"; then
        log_msg "内核启动完成 (PID: ${pid})"
        return 0
    fi
    log_msg "错误: 内核启动后立即退出，请检查 ${LOG_FILE}"
    rm -f "${PID_FILE}"
    return 1
}

# 重启内核：只换内核进程，管理服务与刷新守护进程都不动。
# 返回码：0=成功，1=失败
restart_kernel() {
    stop_kernel_only
    sleep 1
    start_kernel_only
}

# 重启标记：status 在标记有效期内仍报「运行中」，避免 fnOS 误判应用已停止。
mark_restarting() {
    echo "$$" > "${RESTART_FLAG}" 2>/dev/null
}

clear_restarting() {
    rm -f "${RESTART_FLAG}" 2>/dev/null
}

# 标记是否还有效：持锁进程还活着（且不超过 5 分钟）就算「正在重启」
restart_in_progress() {
    [ -f "${RESTART_FLAG}" ] || return 1
    local pid age
    pid=$(head -n 1 "${RESTART_FLAG}" 2>/dev/null | tr -d '[:space:]')
    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        # 持标记的进程没了 —— 可能是上次重启崩了留下的残留，清掉
        clear_restarting
        return 1
    fi
    # 超过 5 分钟还留着标记，说明异常退出没清干净
    age=$(find "${RESTART_FLAG}" -mmin +5 2>/dev/null)
    if [ -n "${age}" ]; then
        clear_restarting
        return 1
    fi
    return 0
}

# 刷新守护进程按当前设置对齐（订阅类型/间隔变了就起或停）
sync_refresh_daemon() {
    local sub_type sub_url refresh_interval
    sub_type=$(grep '^wizard_sub_type=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\r\n')
    if [ "${sub_type}" = "remote" ] && [ -n "${sub_url}" ] && [ "${refresh_interval:-0}" -gt 0 ] 2>/dev/null; then
        start_refresh_daemon
    else
        stop_refresh_daemon
    fi
}

# ============ 管理服务（Web 管理界面）============

# 运行期脚本的「真实来源目录」。刻意不看 ${TRIM_PKGVAR}/cmd —— 那是同步出来的
# 副本，把它当成来源会导致「副本同步副本」自我循环、升级后永远拿不到新版本。
find_cmd_source_dir() {
    for d in "${TRIM_APPDEST}/cmd" "/var/apps/miproxy/cmd" "/var/packages/miproxy/cmd" "${MAIN_DIR}"; do
        [ -n "${d}" ] || continue
        if [ -f "${d}/main" ] && [ -f "${d}/admin_server.py" ]; then
            echo "${d}"
            return 0
        fi
    done
    return 1
}

# 把运行期脚本同步一份到数据目录（${TRIM_PKGVAR}/cmd）。
# 为什么需要：fnOS 安装/升级时先在 /vol1/appcenter-downloads/<包名> 解包并从那里
# 执行 install_callback，装完临时目录被清理，而由它拉起的 main / 管理服务仍指向
# 那个已消失的路径。数据目录是唯一稳定的位置，管理服务 admin_server.py 里的
# CMD_DIRS 也把 ${TRIM_PKGVAR}/cmd 列为候选，两边配合后「装完不重启也能用」。
sync_cmd_scripts() {
    local src_dir
    src_dir=$(find_cmd_source_dir) || {
        log_msg "警告: 未找到脚本源目录（已试 TRIM_APPDEST、/var/apps、本脚本目录），跳过脚本同步"
        return 0
    }
    local dest="${TRIM_PKGVAR}/cmd"
    mkdir -p "${dest}" 2>/dev/null
    local name
    for name in main admin_server.py config_callback refresh_sub sub_download.sh miproxy_config_lib.sh sub_convert.py; do
        [ -f "${src_dir}/${name}" ] || continue
        # 每次都比对内容：只在「不存在时复制」会让升级后数据目录里的旧副本一直生效
        if ! cmp -s "${src_dir}/${name}" "${dest}/${name}" 2>/dev/null; then
            if cp -f "${src_dir}/${name}" "${dest}/${name}" 2>/dev/null; then
                chmod +x "${dest}/${name}" 2>/dev/null
                log_msg "已同步 ${name} 到数据目录（来源 ${src_dir}）"
            else
                log_msg "警告: 同步 ${name} 到数据目录失败（来源 ${src_dir}）"
            fi
        fi
    done
    # refresh_sub 是被复制到数据目录根目录运行的，它要用的 sub_download.sh /
    # sub_convert.py 也得放在同一层，否则 source / 探测不到。
    if [ -f "${src_dir}/sub_download.sh" ] && [ ! -f "${TRIM_PKGVAR}/sub_download.sh" ]; then
        cp -f "${src_dir}/sub_download.sh" "${TRIM_PKGVAR}/sub_download.sh" 2>/dev/null
    fi
    if [ -f "${src_dir}/sub_convert.py" ] && [ ! -f "${TRIM_PKGVAR}/sub_convert.py" ]; then
        cp -f "${src_dir}/sub_convert.py" "${TRIM_PKGVAR}/sub_convert.py" 2>/dev/null
    fi
}

find_admin_script() {
    # 顺序很重要：安装/升级时 fnOS 会从 /vol1/appcenter-downloads/<包名> 里执行
    # install_callback，它再拉 main —— 此时 ${MAIN_DIR} 指向那个临时解包目录，
    # 装完就被系统删掉。若优先用 MAIN_DIR，管理服务就会从一个注定消失的路径启动，
    # 之后它找 config_callback 必然失败（页面正常、一保存就报错）。
    # 所以先认数据目录里的同步副本与 TRIM_APPDEST（真实安装目录），
    # MAIN_DIR 放最后兜底（本地开发用）。
    for p in "${TRIM_PKGVAR}/cmd/admin_server.py" "${TRIM_APPDEST}/cmd/admin_server.py" \
             "/var/apps/miproxy/cmd/admin_server.py" "/var/packages/miproxy/cmd/admin_server.py" \
             "${MAIN_DIR}/admin_server.py"; do
        [ -f "${p}" ] && { echo "${p}"; return 0; }
    done
    return 1
}

start_admin() {
    # 已在运行则跳过。
    # 存活判定用「端口是否在监听」，而不是「pid 文件里的进程是否活着」：
    # admin.pid 有两个写入方 —— main 写的是 nohup 起的 $!，admin_server.py 自己
    # 又会用 os.getpid() 覆写一遍。两者的 PID 语义在某些环境下并不一致（本地
    # Windows 调试就是 native PID vs MSYS PID），按 pid 判活会误判成「没运行」，
    # 于是把 pid 文件删掉、或者重复拉起第二个实例抢端口。
    # 端口在监听才是「管理服务确实活着」的事实。
    local port
    port=$(grep '^wizard_admin_port=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
    port="${port:-9091}"

    if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
        log_msg "管理端口 ${port} 已在监听（视为管理服务已在运行），跳过启动"
        return 0
    fi

    if [ -f "${ADMIN_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(head -n 1 "${ADMIN_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        if [ -n "${existing_pid}" ] && check_process "${existing_pid}"; then
            # 进程活着但端口还没起来：给它一点时间，别重复拉起
            log_msg "管理服务进程已在运行 (PID: ${existing_pid})，等待端口就绪"
            return 0
        fi
        rm -f "${ADMIN_PID_FILE}"
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        log_msg "警告: 未找到 python3，管理界面不可用（跳过启动管理服务）"
        return 0
    fi

    local script
    # 先把运行期脚本同步到数据目录，再从中挑选 —— 这样即便当前 main 是从临时的
    # 解包目录跑起来的，管理服务也会从一个长期有效的路径启动。
    sync_cmd_scripts
    script=$(find_admin_script) || {
        log_msg "警告: 未找到 admin_server.py，跳过管理服务"
        return 0
    }

    log_msg "启动管理服务 (端口: ${port}, 脚本: ${script})..."
    nohup env TRIM_PKGVAR="${TRIM_PKGVAR}" TRIM_PKGETC="${TRIM_PKGETC}" TRIM_APPDEST="${TRIM_APPDEST}" \
        ADMIN_PORT="${port}" python3 "${script}" >> "${TRIM_PKGVAR}/admin.log" 2>&1 &
    local pid=$!
    # 只在 pid 文件不存在时写：管理服务启动后会用 os.getpid() 覆写它（那才是它的真实 pid）。
    # 这里写 $! 是「兜底」，别反过来把管理服务自己写的正确 pid 覆盖掉。
    [ -f "${ADMIN_PID_FILE}" ] || echo "${pid}" > "${ADMIN_PID_FILE}"

    sleep 1
    if check_process "${pid}"; then
        log_msg "管理服务已启动 (PID: ${pid})"
        return 0
    else
        log_msg "警告: 管理服务启动失败，请查看 ${TRIM_PKGVAR}/admin.log"
        rm -f "${ADMIN_PID_FILE}"
        return 1
    fi
}

stop_admin() {
    # 由管理界面自身触发的配置变更，不能杀掉管理服务，否则请求会中断
    if [ "${MIPROXY_KEEP_ADMIN}" = "1" ]; then
        log_msg "配置变更中，保留管理服务"
        return 0
    fi
    if [ -f "${ADMIN_PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${ADMIN_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            log_msg "停止管理服务 (PID: ${pid})..."
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
            sleep 1
            if check_process "${pid}"; then
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
        rm -f "${ADMIN_PID_FILE}"
    fi
}

# ============ miproxy 主进程管理 ============

start_process() {
    if is_running; then
        log_msg "miproxy 已在运行"
        return 0
    fi

    # 启动前先校验二进制和配置文件
    if [ ! -x "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 二进制不存在或不可执行: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: mihomo 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi

    log_msg "启动 miproxy (cmd: ${CMD})..."
    # 直接调用而不是 `bash -c "${CMD}"`：后者会按空格重新拆词（路径含空格就废了），
    # 且多一层 shell，$! 拿到的不一定是内核自己的 PID。
    # nohup：内核是常驻服务，必须脱离调用方（main 自身或其它瞬态脚本）进程树，
    # 否则调用方一退出内核就跟着被 SIGHUP 杀掉。
    nohup "${MIHOMO_BIN}" -d "${MIHOMO_DIR}" -f "${MIHOMO_CONFIG}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > ${PID_FILE}

    # 等待并验证 mihomo 是否真的启动成功
    sleep 2
    if check_process "${pid}"; then
        log_msg "miproxy 启动完成 (PID: ${pid})"
        
        # 启动订阅刷新守护进程
        start_refresh_daemon
        return 0
    else
        log_msg "错误: miproxy 启动后立即退出，请检查 ${LOG_FILE}"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "停止 miproxy..."

    # 先停止订阅刷新守护进程与管理服务
    stop_refresh_daemon
    stop_admin

    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    fi

    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        log_msg "进程未运行"
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "发送 TERM 信号到 PID:${pid}..."
    kill -TERM ${pid} >> ${LOG_FILE} 2>&1 || true

    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "等待进程退出... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "TERM 信号未生效，发送 KILL 信号到 PID:${pid}..."
        kill -KILL "${pid}" 2>/dev/null || true
        sleep 1
    fi
    rm -f "${PID_FILE}"
    log_msg "进程已停止"
    return 0
}

case "$1" in
start)
    start_process
    rc=$?
    # 无论内核是否成功都启动管理服务，便于在界面里排查/修正配置
    start_admin
    if [ ${rc} -eq 0 ]; then
        exit 0
    else
        # 把错误写到 fnOS 能识别的地方
        echo "miproxy 启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        exit 1
    fi
    ;;
stop)
    stop_process
    exit $?
    ;;
restart)
    # 全量重启（内核 + 守护进程 + 管理服务）。重启期间打标记，
    # 免得 fnOS 在 status 上抓到「停止」这一瞬把应用标成已停止。
    mark_restarting
    stop_process
    sleep 2
    start_process
    rc=$?
    start_admin
    clear_restarting
    exit ${rc}
    ;;
restart-kernel)
    # 只重启内核：管理服务与刷新守护进程原地不动。
    # config_callback 用它来应用新配置 —— 不再走 stop+start 全家桶，
    # 避免「切换订阅 → 应用被判停止 → 需要手动启动」。
    mark_restarting
    restart_kernel
    rc=$?
    clear_restarting
    if [ ${rc} -eq 0 ]; then
        exit 0
    else
        echo "miproxy 内核重启失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        exit 1
    fi
    ;;
sync-daemon)
    # 订阅类型/刷新间隔变了之后，让刷新守护进程与新设置对齐
    sync_refresh_daemon
    exit $?
    ;;
status)
    if is_running; then
        exit 0
    fi
    # 内核正在重启：仍报「运行中」。
    # 否则 fnOS 巡检到换配置的中间态就会把应用标成「已停止」，
    # 用户就得手动去应用中心点启动 —— 这正是「切换订阅后应用直接停止」的成因。
    if restart_in_progress; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
