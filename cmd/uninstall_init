#!/bin/bash
#
# MiProxy 卸载前回调
# 功能：停止服务，确保可以安全卸载
#

set +e

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 开始卸载前准备..."

# 获取卸载选项
DATA_ACTION="${wizard_data_action:-keep}"

# 停止主服务
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true

# 强制终止本应用残留的内核进程。
# 不能用 `pkill -f mihomo`：它会匹配命令行里含 "mihomo" 的任何进程，
# 把同机其它代理应用（以及用户自己跑的 mihomo）一起杀掉。这里只匹配本应用的内核路径。
if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}/target" ]; then
    pkill -f "${TRIM_PKGVAR}/target/mihomo" 2>/dev/null || true
fi

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 服务已停止"
echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 卸载准备完成"
exit 0

