#!/bin/bash
#
# MiProxy 卸载回调
# 功能：根据 wizard_data_action 决定是否保留数据
#

set +e

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 开始卸载..."

# 获取卸载选项
DATA_ACTION="${wizard_data_action:-keep}"

# 停止管理服务（无论是否保留数据都要停）
ADMIN_PID_FILE="${TRIM_PKGVAR}/admin.pid"
if [ -f "${ADMIN_PID_FILE}" ]; then
    ADMIN_PID=$(head -n 1 "${ADMIN_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    if [ -n "${ADMIN_PID}" ] && kill -0 "${ADMIN_PID}" 2>/dev/null; then
        kill -TERM "${ADMIN_PID}" 2>/dev/null || true
        sleep 1
        kill -KILL "${ADMIN_PID}" 2>/dev/null || true
    fi
    rm -f "${ADMIN_PID_FILE}"
fi

# 删除前确认目标是本应用专属目录：fnOS 用 appname 命名目录（…/miproxy）。
# 万一 TRIM_* 被误设成 /vol1 之类，直接 rm -rf 就会把整卷数据删掉，所以加一道白名单。
is_app_dir() {
    case "$1" in
        */miproxy|*/miproxy/*) return 0 ;;
        *) return 1 ;;
    esac
}

purge_dir() {
    local dir="$1" label="$2"
    [ -n "${dir}" ] || return 0
    [ -d "${dir}" ] || return 0
    if ! is_app_dir "${dir}"; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 跳过${label}：${dir}（路径不含 miproxy，出于安全不删除）"
        return 0
    fi
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除${label}: ${dir}"
    rm -rf "${dir:?}"/* 2>/dev/null || true
    # 用 .[!.]* / ..?* 而不是 .*：后者会匹配 . 和 ..，必然报错
    rm -rf "${dir:?}"/.[!.]* 2>/dev/null || true
    rm -rf "${dir:?}"/..?* 2>/dev/null || true
}

if [ "$DATA_ACTION" = "delete" ]; then
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 选择删除全部数据"
    
    # 停止服务
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    
    # ============================================
    # 使用 TRIM_* 变量清理所有应用目录
    # ============================================
    purge_dir "${TRIM_APPDEST}" "应用目录"      # /vol*/@appcenter/miproxy
    purge_dir "${TRIM_PKGETC}"  "配置目录"      # /vol*/@appconf/miproxy
    purge_dir "${TRIM_PKGVAR}"  "数据目录"      # /vol*/@appdata/miproxy
    purge_dir "${TRIM_PKGTMP}"  "临时目录"      # /vol*/@apptemp/miproxy
    purge_dir "${TRIM_PKGHOME}" "用户数据目录"  # /vol*/@apphome/miproxy
    purge_dir "${TRIM_PKGMETA}" "元数据目录"    # /var/apps/miproxy/meta
    
    # 7. 清理 PID 文件
    rm -f "${TRIM_PKGVAR}/app.pid" 2>/dev/null || true
    rm -f "${TRIM_PKGVAR}/refresh_sub.pid" 2>/dev/null || true
    rm -f "${TRIM_PKGVAR}/refresh_sub.lock" 2>/dev/null || true
    rm -f "${TRIM_PKGVAR}/admin.pid" 2>/dev/null || true
    
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 所有数据已删除"
else
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 保留数据"
fi

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 卸载完成"
exit 0

