#!/bin/bash
# MiProxy 配置变更回调（v7 完整字段同步版）
# 关键修复：完整同步订阅源的所有配置字段
# 同步字段：proxies / proxy-groups / rules / dns / hosts / bypass / proxy-providers / rule-providers 等

DEBUG_LOG="${TRIM_PKGVAR}/config_callback.log"
exec 2>>"${DEBUG_LOG}"
echo "===== config_callback v7 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"
CONFIG_FILE="${VAR_DIR}/config.yaml"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 订阅下载统一入口（带 Clash 专用 UA，见 cmd/sub_download.sh 顶部说明）
if [ -f "${SCRIPT_DIR}/sub_download.sh" ]; then
    . "${SCRIPT_DIR}/sub_download.sh"
fi

# 防御：fnOS 的向导/管理界面一定会带 wizard_* 环境变量下发。
# 若一个都没有（用户手动执行 `bash /var/apps/miproxy/cmd/config_callback` 排障的场景），
# 就回退到 settings.conf 里已生效的配置；否则会把订阅、端口等整体清空成默认值。
if [ -z "${wizard_sub_type+X}${wizard_http_port+X}${wizard_tun_enable+X}" ] && [ -f "${TRIM_PKGETC}/settings.conf" ]; then
    log_msg "未收到 wizard_* 环境变量（疑似手动执行），改为复用 settings.conf 中的现有配置"
    while IFS='=' read -r _wk _wv; do
        case "${_wk}" in
            wizard_*) export "${_wk}=${_wv}" ;;
        esac
    done < "${TRIM_PKGETC}/settings.conf"
fi

PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-0}"
TUN_ENABLE="${wizard_tun_enable:-false}"

HTTP_PORT=""; API_PORT=""; PREV_SUB_URL=""; ADMIN_PORT_KEEP=""; ADMIN_TOKEN_KEEP=""
if [ -f "${TRIM_PKGETC}/settings.conf" ]; then
    HTTP_PORT=$(grep '^wizard_http_port=' "${TRIM_PKGETC}/settings.conf" | cut -d= -f2- | tr -d '\r\n')
    API_PORT=$(grep '^wizard_api_port=' "${TRIM_PKGETC}/settings.conf" | cut -d= -f2- | tr -d '\r\n')
    PREV_SUB_URL=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" | cut -d= -f2- | tr -d '\r\n')
    # settings.conf 由本脚本整体重写，未列出的键会被丢弃 —— 管理服务相关键需显式保留
    ADMIN_PORT_KEEP=$(grep '^wizard_admin_port=' "${TRIM_PKGETC}/settings.conf" | cut -d= -f2- | tr -d '[:space:]')
    ADMIN_TOKEN_KEEP=$(grep '^wizard_admin_token=' "${TRIM_PKGETC}/settings.conf" | cut -d= -f2- | tr -d '[:space:]')
fi
HTTP_PORT="${wizard_http_port:-${HTTP_PORT:-7890}}"
API_PORT="${wizard_api_port:-${API_PORT:-9090}}"

log_msg "config_callback v7 启动"
log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL:-（空）}, PREV=${PREV_SUB_URL:-（空）}"

SUB_DOMAIN_FILTER=""
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    domain=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||')
    [ -n "${domain}" ] && SUB_DOMAIN_FILTER="    - \"${domain}\"
    - \"*.${domain}\"
"
fi

SUB_CACHE_PATH="${VAR_DIR}/proxy_providers/subscription.yaml"
mkdir -p "${VAR_DIR}/proxy_providers"

NEED_DOWNLOAD=0
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    if [ "${PREV_SUB_URL}" != "${SUB_URL}" ]; then
        NEED_DOWNLOAD=1; log_msg "  📌 订阅 URL 变更，强制重下"
    elif [ ! -f "${SUB_CACHE_PATH}" ]; then
        NEED_DOWNLOAD=1; log_msg "  📌 缓存不存在，重新下载"
    else
        log_msg "  ✓ 订阅 URL 未变且缓存存在，复用"
    fi
fi

if [ "${NEED_DOWNLOAD}" = "1" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if [ -z "${SUB_URL}" ]; then
        log_msg "  ⚠️ 订阅类型为 remote 但没有订阅链接，跳过下载"
    elif command -v download_subscription >/dev/null 2>&1; then
        # download_subscription：0=拿到 Clash YAML，2=下到了但不是 Clash 格式
        download_subscription "${SUB_URL}" "${SUB_CACHE_PATH}"
        rc=$?
        if [ "${rc}" = "0" ]; then
            log_msg "  ✅ 订阅下载成功: $(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}") bytes"
        elif [ "${rc}" = "2" ]; then
            log_msg "  ⚠️ 订阅已下载，但不是 Clash/mihomo 格式（已保留原缓存文件供诊断）"
        else
            log_msg "  ⚠️ 订阅下载失败，使用上次缓存"
        fi
    else
        # 兜底：辅助脚本缺失时退回最原始的下载方式
        if curl -fsSL --connect-timeout 15 --max-time 60 -A "clash.meta" "${SUB_URL}" -o "${SUB_CACHE_PATH}.tmp" 2>>"${DEBUG_LOG}" && [ -s "${SUB_CACHE_PATH}.tmp" ]; then
            mv "${SUB_CACHE_PATH}.tmp" "${SUB_CACHE_PATH}"
            log_msg "  ✅ 订阅下载成功: $(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}") bytes"
        else
            log_msg "  ⚠️ 订阅下载失败，使用上次缓存"
            rm -f "${SUB_CACHE_PATH}.tmp"
        fi
    fi
fi

[ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ] && cp -f "${SUB_PATH}" "${SUB_CACHE_PATH}"

# 完整版 yaml 块提取：支持订阅源特殊格式（proxies: 块中列表项为顶格 -）
extract_yaml_block() {
    # 解析失败不再静默丢弃：stderr 统一写入 info.log（python3 缺失/文件不可读/语法错误均可追溯）
    python3 - "$1" "$2" 2>>"${LOG_FILE:-/dev/null}" <<'PYEOF'
import sys
key = sys.argv[1] + ":"
try:
    with open(sys.argv[2], 'r', encoding='utf-8') as f:
        lines = f.readlines()
except Exception as e:
    sys.stderr.write("[extract_yaml_block] 读取订阅缓存失败: %s (%s: %s)\n" % (sys.argv[2], type(e).__name__, e))
    sys.exit(3)
result = []
found = False
for line in lines:
    stripped = line.rstrip('\n')
    if not stripped.strip():
        if found: result.append(line)
        continue
    is_top = not stripped[0].isspace()
    if is_top:
        if stripped.startswith(key):
            found = True
            result.append(line)
        elif found:
            if stripped.startswith('-'):
                result.append(line)
            else:
                break
    elif found:
        result.append(line)
sys.stdout.write(''.join(result))
PYEOF
}

# ============ v7: 完整字段同步 ============
# 同步所有来自订阅源的配置字段
SUB_PROXIES=""; SUB_HOSTS=""; SUB_PG=""; SUB_RULES=""; SUB_DNS=""
SUB_BYPASS=""; SUB_PROXY_PROVIDERS=""; SUB_RULE_PROVIDERS=""; SUB_SUB_RULE=""
SUB_TUNNELS=""; SUB_LISTENERS=""; SUB_SNIFF=""; SUB_NTP=""; SUB_SCRIPT=""

HAVE_PY3=1
if [ -f "${SUB_CACHE_PATH}" ] && ! command -v python3 >/dev/null 2>&1; then
    HAVE_PY3=0
    log_msg "错误: 未找到 python3，无法解析订阅字段，生成的 config 将不包含任何节点（请在 fnOS 安装 python3 后重新保存配置）"
fi

# 只有启用订阅（remote/local）时才使用缓存；否则即使残留旧缓存也不应把节点写进 config
if [ -f "${SUB_CACHE_PATH}" ] && [ "${SUB_TYPE}" = "none" ]; then
    log_msg "未启用订阅（sub_type=none），忽略已有订阅缓存，生成默认规则配置"
fi

if [ -f "${SUB_CACHE_PATH}" ] && [ "${HAVE_PY3}" = "1" ] && { [ "${SUB_TYPE}" = "remote" ] || [ "${SUB_TYPE}" = "local" ]; }; then
    # 基础字段（原有）
    SUB_PROXIES=$(extract_yaml_block "proxies" "${SUB_CACHE_PATH}")
    SUB_HOSTS=$(extract_yaml_block "hosts" "${SUB_CACHE_PATH}")
    SUB_PG=$(extract_yaml_block "proxy-groups" "${SUB_CACHE_PATH}")
    SUB_RULES=$(extract_yaml_block "rules" "${SUB_CACHE_PATH}")
    SUB_DNS=$(extract_yaml_block "dns" "${SUB_CACHE_PATH}")
    
    # 扩展字段（v7 新增）
    SUB_BYPASS=$(extract_yaml_block "bypass" "${SUB_CACHE_PATH}")
    SUB_PROXY_PROVIDERS=$(extract_yaml_block "proxy-providers" "${SUB_CACHE_PATH}")
    SUB_RULE_PROVIDERS=$(extract_yaml_block "rule-providers" "${SUB_CACHE_PATH}")
    SUB_SUB_RULE=$(extract_yaml_block "sub-rule" "${SUB_CACHE_PATH}")
    SUB_TUNNELS=$(extract_yaml_block "tunnels" "${SUB_CACHE_PATH}")
    SUB_LISTENERS=$(extract_yaml_block "listeners" "${SUB_CACHE_PATH}")
    SUB_SNIFF=$(extract_yaml_block "sniff" "${SUB_CACHE_PATH}")
    SUB_NTP=$(extract_yaml_block "ntp" "${SUB_CACHE_PATH}")
    SUB_SCRIPT=$(extract_yaml_block "script" "${SUB_CACHE_PATH}")
    
    log_msg "  📦 字段同步统计:"
    log_msg "      proxies:$(printf '%s' "${SUB_PROXIES}" | wc -l)行"
    log_msg "      hosts:$(printf '%s' "${SUB_HOSTS}" | wc -l)行"
    log_msg "      proxy-groups:$(printf '%s' "${SUB_PG}" | wc -l)行"
    log_msg "      rules:$(printf '%s' "${SUB_RULES}" | wc -l)行"
    log_msg "      dns:$(printf '%s' "${SUB_DNS}" | wc -l)行"
    log_msg "      bypass:$(printf '%s' "${SUB_BYPASS}" | wc -l)行"
    log_msg "      proxy-providers:$(printf '%s' "${SUB_PROXY_PROVIDERS}" | wc -l)行"
    log_msg "      rule-providers:$(printf '%s' "${SUB_RULE_PROVIDERS}" | wc -l)行"
    log_msg "      sub-rule:$(printf '%s' "${SUB_SUB_RULE}" | wc -l)行"
    log_msg "      tunnels:$(printf '%s' "${SUB_TUNNELS}" | wc -l)行"
    log_msg "      listeners:$(printf '%s' "${SUB_LISTENERS}" | wc -l)行"
    log_msg "      sniff:$(printf '%s' "${SUB_SNIFF}" | wc -l)行"
    log_msg "      ntp:$(printf '%s' "${SUB_NTP}" | wc -l)行"
    log_msg "      script:$(printf '%s' "${SUB_SCRIPT}" | wc -l)行"
    
    [ -n "${SUB_DNS}" ] && ! printf '%s' "${SUB_DNS}" | grep -q "nameserver" && SUB_DNS="" && log_msg "  ⚠️ dns 缺 nameserver，回退本地默认"
fi

# ============ 订阅有效性校验 ============
# 「订阅启用了，却一个节点都没解析出来」是最容易被当成成功的情况：
# 订阅下载成功（HTTP 200）、config.yaml 也重新生成了，但里面一条 proxies 都没有，
# 用户看到的只是「已生效」，实际节点数为 0。
# 这里做两件事：①说清楚到底是哪种格式问题；②绝不用一份空配置覆盖掉还能用的旧配置。
diagnose_subscription() {
    python3 - "${1}" 2>>"${LOG_FILE}" <<'PYEOF'
import sys, re
p = sys.argv[1]
try:
    data = open(p, 'rb').read()
except Exception as e:
    print("订阅缓存读取失败（%s）" % e)
    sys.exit(0)
if not data:
    print("订阅缓存是空文件")
    sys.exit(0)
text = data.decode('utf-8', 'replace')
head = ' '.join(text[:120].split())
size = len(data)
stripped = text.strip()
if re.match(r'^\s*(<\?xml|<!DOCTYPE|<html)', text, re.I):
    print("订阅返回的是 HTML 网页而不是配置（链接可能需要 User-Agent/令牌，或被中间层劫持）；开头：%s" % head)
elif stripped.startswith('{') or stripped.startswith('['):
    print("订阅返回的是 JSON 而不是 Clash YAML；开头：%s" % head)
elif ':' not in stripped and re.match(r'^[A-Za-z0-9+/=\s]{40,}$', stripped):
    print("订阅返回的是 base64 编码内容（多半是 v2ray/ss 链接），需先转换成 Clash/mihomo 格式；开头：%s" % head[:60])
elif 'proxies:' not in text and 'proxy-providers:' not in text:
    print("订阅里没有 proxies: / proxy-providers: 段（共 %d 字节，开头：%s）" % (size, head))
else:
    print("订阅格式可疑（共 %d 字节，开头：%s）" % (size, head))
PYEOF
}

# 当前 config.yaml 里还有没有节点（用于决定能否覆盖）
config_has_nodes() {
    python3 - "${CONFIG_FILE}" 2>>"${LOG_FILE}" <<'PYEOF'
import sys
try:
    lines = open(sys.argv[1], encoding='utf-8', errors='replace').read().split('\n')
except Exception:
    print("no")
    sys.exit(0)
inblk = False
for l in lines:
    if l.startswith('proxies:'):
        inblk = True
        continue
    if inblk:
        if not l.strip():
            continue
        if not l[0].isspace():
            break
        if l.strip().startswith('-'):
            print("yes")
            sys.exit(0)
print("no")
PYEOF
}

SUB_HAS_NODES=1
if [ "${SUB_TYPE}" = "remote" ] || [ "${SUB_TYPE}" = "local" ]; then
    SUB_PROXY_LINES=$(printf '%s' "${SUB_PROXIES}" | wc -l | tr -d ' ')
    SUB_PROVIDER_LINES=$(printf '%s' "${SUB_PROXY_PROVIDERS}" | wc -l | tr -d ' ')
    if [ "${SUB_PROXY_LINES}" -eq 0 ] && [ "${SUB_PROVIDER_LINES}" -eq 0 ]; then
        SUB_DIAG=$(diagnose_subscription "${SUB_CACHE_PATH}")
        log_msg "  ❌ 订阅未解析出任何节点：${SUB_DIAG}"
        if [ "$(config_has_nodes)" = "yes" ]; then
            # 旧配置里还有能用的节点 → 保留它，别把用户洗成 0 节点
            log_msg "  ⚠️ 已保留原 config.yaml（其中仍有可用节点），本次订阅未应用"
            log_msg "===== config_callback v7 完成（订阅无节点，未应用）====="
            exit 4
        fi
        SUB_HAS_NODES=0
    fi
fi

log_msg "重新生成 config.yaml..."

{
    echo "# MiProxy 主配置（v7：完整同步订阅源所有字段）"
    echo ""
    echo "mixed-port: ${HTTP_PORT}"
    echo "allow-lan: true"
    echo "mode: rule"
    echo "log-level: info"
    echo "ipv6: false"
    echo "external-controller: 0.0.0.0:${API_PORT}"
    echo "external-ui: ${UI_TARGET}"
    echo "external-ui-name: zashboard"
    [ -n "${SECRET}" ] && echo "secret: \"${SECRET}\""
    [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ] && echo "authentication:" && echo "  - \"${PROXY_USER}:${PROXY_PASS}\""
    echo "external-controller-cors:"
    echo "  allow-private-network: true"
    echo "  allow-origins: [\"*\"]"
    echo "geodata-mode: true"
    echo "geodata-loader: memconservative"
    echo "tun:"
    echo "  enable: ${TUN_ENABLE}"
    echo "  stack: mixed"
    echo "  auto-route: true"
    echo "  auto-redirect: true"
    echo "  auto-detect-interface: true"
    echo "  device: miproxy"
    echo "  mtu: 1500"
    echo "  dns-hijack: [\"any:53\", \"tcp://any:53\"]"
    echo "  strict-route: true"
    echo "  gso: true"
    echo "  gso-max-size: 65536"

    # ============ 来自订阅源的字段 ============
    [ -n "${SUB_PROXIES}" ] && echo "# 节点列表（来自订阅源）" && echo "${SUB_PROXIES}"
    [ -n "${SUB_HOSTS}" ] && echo "# hosts（来自订阅源）" && echo "${SUB_HOSTS}"

    if [ -n "${SUB_PG}" ]; then
        echo "# 代理组（来自订阅源）"
        echo "${SUB_PG}"
    else
        echo "proxy-groups:"
        echo "  - name: PROXY"
        echo "    type: select"
        echo "    proxies: [DIRECT, REJECT]"
    fi

    if [ -n "${SUB_RULES}" ]; then
        echo "# 路由规则（来自订阅源）"
        echo "${SUB_RULES}"
    else
        echo "rules: [\"GEOIP,CN,DIRECT\", \"MATCH,PROXY\"]"
    fi

    if [ -n "${SUB_DNS}" ]; then
        echo "# DNS（来自订阅源）"
        echo "${SUB_DNS}"
    else
        echo "dns:"
        echo "  enable: true"
        echo "  listen: 0.0.0.0:53"
        echo "  enhanced-mode: fake-ip"
        echo "  fake-ip-range: 198.18.0.1/16"
        echo "  fake-ip-filter: [\"+.lan\", \"+.local\"${SUB_DOMAIN_FILTER:+, \"${domain}\", \"*.${domain}\"}]"
        echo "  nameserver: [223.5.5.5, 119.29.29.29, 8.8.8.8]"
    fi

    # v7 新增字段
    [ -n "${SUB_BYPASS}" ] && echo "# bypass 私有绕过列表（来自订阅源）" && echo "${SUB_BYPASS}"
    [ -n "${SUB_PROXY_PROVIDERS}" ] && echo "# proxy-providers 代理集合（来自订阅源）" && echo "${SUB_PROXY_PROVIDERS}"
    [ -n "${SUB_RULE_PROVIDERS}" ] && echo "# rule-providers 规则集合（来自订阅源）" && echo "${SUB_RULE_PROVIDERS}"
    [ -n "${SUB_SUB_RULE}" ] && echo "# sub-rule 子规则（来自订阅源）" && echo "${SUB_SUB_RULE}"
    [ -n "${SUB_TUNNELS}" ] && echo "# tunnels 流量隧道（来自订阅源）" && echo "${SUB_TUNNELS}"
    [ -n "${SUB_LISTENERS}" ] && echo "# listeners 监听器（来自订阅源）" && echo "${SUB_LISTENERS}"
    [ -n "${SUB_SNIFF}" ] && echo "# sniff 嗅探（来自订阅源）" && echo "${SUB_SNIFF}"
    [ -n "${SUB_NTP}" ] && echo "# ntp 时间同步（来自订阅源）" && echo "${SUB_NTP}"
    [ -n "${SUB_SCRIPT}" ] && echo "# script 脚本（来自订阅源）" && echo "${SUB_SCRIPT}"
} > "${CONFIG_FILE}"

chmod 666 "${CONFIG_FILE}"
log_msg "✅ config.yaml 已重新生成"

{
    echo "wizard_http_port=${HTTP_PORT}"
    echo "wizard_api_port=${API_PORT}"
    echo "wizard_tun_enable=${TUN_ENABLE}"
    echo "wizard_sub_type=${SUB_TYPE}"
    echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
    [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
    [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
    [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
    [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
    [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
    [ -n "${ADMIN_PORT_KEEP}" ] && echo "wizard_admin_port=${ADMIN_PORT_KEEP}"
    [ -n "${ADMIN_TOKEN_KEEP}" ] && echo "wizard_admin_token=${ADMIN_TOKEN_KEEP}"
} > "${TRIM_PKGETC}/settings.conf"
chmod 666 "${TRIM_PKGETC}/settings.conf" 2>/dev/null

rm -f "${VAR_DIR}/base.yaml" "${VAR_DIR}/subscription.yaml" "${VAR_DIR}/subscription.conf"

# MIPROXY_NO_RESTART=1：由 refresh_sub 定时刷新调用时只重生成 config.yaml，不碰内核。
# 原因：main stop 会 kill 掉调用方（订阅刷新守护进程自己），且守护进程本来就会紧接着重启内核。
if [ "${MIPROXY_NO_RESTART:-0}" = "1" ]; then
    log_msg "MIPROXY_NO_RESTART=1，跳过内核重启（由调用方负责重启）"
else
    # ⚠️ 必须保留管理服务：main stop 默认会把管理服务一起停掉，那样
    # ① 正在打开的管理页面请求被中断，用户看到「应用崩了」；
    # ② 被 fnOS 向导触发时（那条路径不会带 MIPROXY_KEEP_ADMIN）更是必停。
    # 内核重启与管理服务本就是两个独立进程，改配置不该牵连管理服务。
    export MIPROXY_KEEP_ADMIN=1
    bash "${SCRIPT_DIR}/main" stop 2>>"${LOG_FILE}" || true
    sleep 2
    if bash "${SCRIPT_DIR}/main" start 2>>"${LOG_FILE}"; then
        log_msg "✅ miproxy 重启成功"
    else
        # 重启失败必须让调用方感知：config.yaml 已经写好了，但内核还在跑旧配置（或根本没起来），
        # 这时候「保存成功」是假象 —— 管理界面会据此提示「配置已写入但内核未重启」。
        log_msg "⚠️  miproxy 重启失败：config.yaml 已写入，但内核仍是旧配置或未运行"
        log_msg "===== config_callback v7 完成（重启失败）====="
        exit 3
    fi
fi
if [ "${SUB_HAS_NODES}" = "0" ]; then
    # 配置确实写进去了（旧配置本来也没有节点），但订阅没解析出任何节点——
    # 必须让调用方知道「没生效」，否则用户看到的仍是「已启用」。
    log_msg "⚠️  订阅未解析出任何节点：配置已写入，但不会有可用节点"
    log_msg "===== config_callback v7 完成（订阅无节点）====="
    exit 4
fi
log_msg "===== config_callback v7 完成 ====="
exit 0
