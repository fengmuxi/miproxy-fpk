#!/bin/bash
# MiProxy 安装后回调脚本（v11 (sync v2.6.38 stable) 安全修复版 + 保留原始 YAML 格式）
# 修复：域名安全过滤 + 恢复原始 YAML 解析逻辑（保持订阅源格式）

DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"
exec 2>>"${DEBUG_LOG}"
echo "===== install_callback v11 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
TARGET_DIR="${VAR_DIR}/target"
UI_TARGET="${VAR_DIR}/ui"
CONFIG_FILE="${VAR_DIR}/config.yaml"
# 生成中的临时文件：校验通过后才落位到 CONFIG_FILE
CONFIG_TMP="${CONFIG_FILE}.new"
LOG_FILE="${VAR_DIR}/info.log"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 订阅下载统一入口（带 Clash 专用 UA，见 cmd/sub_download.sh 顶部说明）
if [ -f "${SCRIPT_DIR}/sub_download.sh" ]; then
    . "${SCRIPT_DIR}/sub_download.sh"
fi

PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-0}"
TUN_ENABLE="${wizard_tun_enable:-false}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# YAML 块提取（v7 原始逻辑 + 缩进规范化）
# ⚠️ 与 cmd/config_callback 里的同名函数保持一致（历史 bug 多源于「只修了一份」）。
extract_yaml_block() {
    # 解析失败不再静默丢弃：stderr 统一写入 info.log（python3 缺失/文件不可读/语法错误均可追溯）
    python3 - "$1" "$2" 2>>"${LOG_FILE:-/dev/null}" <<'PYEOF'
import sys
key = sys.argv[1] + ":"
try:
    with open(sys.argv[2], 'r', encoding='utf-8') as f:
        lines = f.readlines()
except Exception as e:
    sys.stderr.write("[extract_yaml_block] 读取订阅缓存失败: %s (%s: %s)\n" % (sys.argv[2], type(e).__name__, e))
    sys.exit(3)
result = []
found = False
for line in lines:
    stripped = line.rstrip('\n')
    if not stripped.strip():
        if found: result.append(line)
        continue
    is_top = not stripped[0].isspace()
    if is_top:
        if stripped.startswith(key):
            found = True
            result.append(line)
        elif found:
            if stripped.startswith('-'):
                result.append(line)
            else:
                break
    elif found:
        result.append(line)


def normalize(block):
    """把「顶格 - 」的列表项缩进到父键下面，输出规范的 YAML 块。

    为什么必须做：YAML 允许序列与父键同缩进，所以
        proxies:
        - name: A
    对内核是合法的（节点能正常加载），但一堆简易解析器
    （包括本项目早期版本的管理服务）是按「块内必须缩进」来切段的，
    遇到顶格就认为 proxies 段结束 —— 于是订阅明明有 80 多个节点，
    管理界面却显示 0 个，用户完全看不出问题在哪。
    统一缩进成规范写法，两边就都对了。
    """
    if len(block) <= 1:
        return block
    body = block[1:]
    min_indent = None
    for l in body:
        if not l.strip():
            continue
        indent = len(l) - len(l.lstrip(' '))
        if min_indent is None or indent < min_indent:
            min_indent = indent
    if min_indent is None or min_indent > 0:
        return block          # 本来就是缩进好的，不用动
    out = [block[0]]
    for l in body:
        out.append(('  ' + l) if l.strip() else l.rstrip('\n'))
    return out


sys.stdout.write(''.join(normalize(result)))
PYEOF
}

# 统计一个 YAML 文件里 proxies 段的条目数（顶格/缩进两种写法都认）
count_yaml_nodes() {
    python3 - "$1" 2>>"${LOG_FILE:-/dev/null}" <<'PYEOF'
import sys
path = sys.argv[1]
try:
    lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
except Exception:
    print("0")
    sys.exit(0)
inblk = False
count = 0
for raw in lines:
    if not inblk:
        if raw.strip() == "proxies:":
            inblk = True
        continue
    if raw and not raw[0].isspace():
        if raw.startswith("-"):
            count += 1
        else:
            break
        continue
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("-"):
        count += 1
print(count)
PYEOF
}


log_msg "install_callback v11 启动"
log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL:-（空）}, SUB_PATH=${SUB_PATH:-（空）}"

# 安全提取订阅域名（v9 新增）
SUB_DOMAIN_FILTER=""
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    # 使用 grep -oE 只提取合法域名格式，防止命令注入
    domain=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||' | grep -oE '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*\.[a-zA-Z]{2,}$' | head -1)
    if [ -n "${domain}" ]; then
        log_msg "  提取订阅域名: ${domain}"
        SUB_DOMAIN_FILTER="    - \"${domain}\"\n    - \"*.${domain}\""
    fi
fi

mkdir -p "${TARGET_DIR}" "${VAR_DIR}/proxy_providers" "${UI_TARGET}" "${TRIM_PKGETC}"

log_msg "复制 mihomo 核心..."
# 内置内核始终另存一份 mihomo.bundled；只有当前内核缺失时才用它补齐。
# 这样管理界面里手动切换/升级过的内核不会在「升级应用包」时被悄悄覆盖回去，
# 需要时可在管理界面一键「恢复内置内核」（kernel.json 里记录的是用户当前选择）。
if [ -f "${APP_DEST}/server/mihomo" ]; then
    cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo.bundled"
    chmod +x "${TARGET_DIR}/mihomo.bundled"
    if [ -f "${TARGET_DIR}/mihomo" ]; then
        log_msg "  已存在内核，保留当前版本（内置内核存为 mihomo.bundled，可在管理界面「内核」页恢复）"
    else
        cp -f "${TARGET_DIR}/mihomo.bundled" "${TARGET_DIR}/mihomo"
        chmod +x "${TARGET_DIR}/mihomo"
        log_msg "  ✅ 已部署内置内核"
    fi
fi

[ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
[ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
[ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
[ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
# 带顶栏的包装页：第三方面板在 iframe 里跑，顶部导航行不会遮挡面板自身元素
for _frame in frame-zashboard.html frame-metacubexd.html; do
    [ -f "${APP_DEST}/ui/${_frame}" ] && cp -f "${APP_DEST}/ui/${_frame}" "${UI_TARGET}/${_frame}"
done
unset _frame
[ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
[ -d "${APP_DEST}/ui/admin" ] && mkdir -p "${UI_TARGET}/admin" && cp -rf "${APP_DEST}/ui/admin/"* "${UI_TARGET}/admin/" 2>/dev/null
chmod 666 "${UI_TARGET}/config" 2>/dev/null


[ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
    [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
done

SUB_CACHE_PATH="${VAR_DIR}/proxy_providers/subscription.yaml"

if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if command -v download_subscription >/dev/null 2>&1; then
        download_subscription "${SUB_URL}" "${SUB_CACHE_PATH}"
        rc=$?
        if [ "${rc}" = "0" ]; then
            log_msg "  ✅ 订阅下载成功: $(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}") bytes"
        elif [ "${rc}" = "2" ]; then
            log_msg "  ⚠️ 订阅已下载，但不是 Clash/mihomo 格式（已保留文件供诊断）"
        else
            log_msg "  ⚠️ 订阅下载失败"
        fi
    else
        if curl -fsSL --connect-timeout 15 --max-time 60 -A "clash.meta" "${SUB_URL}" -o "${SUB_CACHE_PATH}.tmp" 2>>"${DEBUG_LOG}" && [ -s "${SUB_CACHE_PATH}.tmp" ]; then
            mv "${SUB_CACHE_PATH}.tmp" "${SUB_CACHE_PATH}"
            log_msg "  ✅ 订阅下载成功: $(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}") bytes"
        else
            log_msg "  ⚠️ 订阅下载失败"
            rm -f "${SUB_CACHE_PATH}.tmp"
        fi
    fi
fi

[ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ] && cp -f "${SUB_PATH}" "${SUB_CACHE_PATH}"

# 订阅缓存体检：文件多大、开头长什么样、proxies 里到底几条，一并写进日志。
# 与 cmd/config_callback 保持一致（两份脚本的日志要能互相印证）。
if [ -f "${SUB_CACHE_PATH}" ]; then
    CACHE_SIZE=$(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}")
    CACHE_HEAD=$(head -c 100 "${SUB_CACHE_PATH}" 2>/dev/null | tr -d '\r\n' | cut -c1-100)
    CACHE_NODES=$(count_yaml_nodes "${SUB_CACHE_PATH}")
    log_msg "  📄 订阅缓存: ${CACHE_SIZE} bytes / proxies 条目 ${CACHE_NODES} 个"
    log_msg "      开头: ${CACHE_HEAD}"
fi
# 订阅里的内联节点数（proxy-providers 型订阅是 0，那是正常的：
# 它的节点由 provider 在运行时拉取，config.yaml 里本来就不该有内联节点）
SUB_INLINE_NODES="${CACHE_NODES:-0}"


# ============ v9: 完整字段同步 ============
SUB_PROXIES=""; SUB_HOSTS=""; SUB_PG=""; SUB_RULES=""; SUB_DNS=""
SUB_BYPASS=""; SUB_PROXY_PROVIDERS=""; SUB_RULE_PROVIDERS=""; SUB_SUB_RULE=""
SUB_TUNNELS=""; SUB_LISTENERS=""; SUB_SNIFF=""; SUB_NTP=""; SUB_SCRIPT=""

HAVE_PY3=1
if [ -f "${SUB_CACHE_PATH}" ] && ! command -v python3 >/dev/null 2>&1; then
    HAVE_PY3=0
    log_msg "错误: 未找到 python3，无法解析订阅字段，生成的 config 将不包含任何节点（请在 fnOS 安装 python3 后重新保存配置）"
fi

# 只有启用订阅（remote/local）时才使用缓存；否则即使残留旧缓存也不应把节点写进 config
if [ -f "${SUB_CACHE_PATH}" ] && [ "${SUB_TYPE}" = "none" ]; then
    log_msg "未启用订阅（sub_type=none），忽略已有订阅缓存，生成默认规则配置"
fi

if [ -f "${SUB_CACHE_PATH}" ] && [ "${HAVE_PY3}" = "1" ] && { [ "${SUB_TYPE}" = "remote" ] || [ "${SUB_TYPE}" = "local" ]; }; then
    # 基础字段
    SUB_PROXIES=$(extract_yaml_block "proxies" "${SUB_CACHE_PATH}")
    SUB_HOSTS=$(extract_yaml_block "hosts" "${SUB_CACHE_PATH}")
    SUB_PG=$(extract_yaml_block "proxy-groups" "${SUB_CACHE_PATH}")
    SUB_RULES=$(extract_yaml_block "rules" "${SUB_CACHE_PATH}")
    SUB_DNS=$(extract_yaml_block "dns" "${SUB_CACHE_PATH}")
    
    # 扩展字段
    SUB_BYPASS=$(extract_yaml_block "bypass" "${SUB_CACHE_PATH}")
    SUB_PROXY_PROVIDERS=$(extract_yaml_block "proxy-providers" "${SUB_CACHE_PATH}")
    SUB_RULE_PROVIDERS=$(extract_yaml_block "rule-providers" "${SUB_CACHE_PATH}")
    SUB_SUB_RULE=$(extract_yaml_block "sub-rule" "${SUB_CACHE_PATH}")
    SUB_TUNNELS=$(extract_yaml_block "tunnels" "${SUB_CACHE_PATH}")
    SUB_LISTENERS=$(extract_yaml_block "listeners" "${SUB_CACHE_PATH}")
    SUB_SNIFF=$(extract_yaml_block "sniff" "${SUB_CACHE_PATH}")
    SUB_NTP=$(extract_yaml_block "ntp" "${SUB_CACHE_PATH}")
    SUB_SCRIPT=$(extract_yaml_block "script" "${SUB_CACHE_PATH}")
    
    log_msg "  📦 字段同步统计:"
    log_msg "      proxies:$(printf '%s' "${SUB_PROXIES}" | wc -l)行"
    log_msg "      hosts:$(printf '%s' "${SUB_HOSTS}" | wc -l)行"
    log_msg "      proxy-groups:$(printf '%s' "${SUB_PG}" | wc -l)行"
    log_msg "      rules:$(printf '%s' "${SUB_RULES}" | wc -l)行"
    log_msg "      dns:$(printf '%s' "${SUB_DNS}" | wc -l)行"
    log_msg "      bypass:$(printf '%s' "${SUB_BYPASS}" | wc -l)行"
    log_msg "      proxy-providers:$(printf '%s' "${SUB_PROXY_PROVIDERS}" | wc -l)行"
    log_msg "      rule-providers:$(printf '%s' "${SUB_RULE_PROVIDERS}" | wc -l)行"
    
    [ -n "${SUB_DNS}" ] && ! printf '%s' "${SUB_DNS}" | grep -q "nameserver" && SUB_DNS="" && log_msg "  ⚠️ dns 缺 nameserver，回退本地默认"
fi

# 订阅启用了却一个节点都没解析出来 —— 生成配置前先记下来，
# 落位时据此决定「保留旧配置」还是「写入并告警」（见下方 CONFIG_TMP 处理）。
SUB_HAS_NODES=1
if [ "${SUB_TYPE}" = "remote" ] || [ "${SUB_TYPE}" = "local" ]; then
    SUB_PROXY_LINES=$(printf '%s' "${SUB_PROXIES}" | wc -l | tr -d ' ')
    SUB_PROVIDER_LINES=$(printf '%s' "${SUB_PROXY_PROVIDERS}" | wc -l | tr -d ' ')
    if [ "${SUB_PROXY_LINES:-0}" -eq 0 ] && [ "${SUB_PROVIDER_LINES:-0}" -eq 0 ]; then
        SUB_HAS_NODES=0
        log_msg "  ❌ 订阅未解析出任何节点（详见上方订阅缓存体检信息）"
    fi
fi

log_msg "生成 config.yaml..."

{
    echo "# MiProxy 主配置（v9：安全修复版）"
    echo ""
    echo "mixed-port: ${HTTP_PORT}"
    echo "allow-lan: true"
    echo "mode: rule"
    echo "log-level: info"
    echo "ipv6: false"
    echo "external-controller: 0.0.0.0:${API_PORT}"
    echo "external-ui: ${UI_TARGET}"
    echo "external-ui-name: zashboard"
    [ -n "${SECRET}" ] && echo "secret: \"${SECRET}\""
    [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ] && echo "authentication:" && echo "  - \"${PROXY_USER}:${PROXY_PASS}\""
    echo "external-controller-cors:"
    echo "  allow-private-network: true"
    echo "  allow-origins: [\"*\"]"
    echo "geodata-mode: true"
    echo "geodata-loader: memconservative"
    echo "tun:"
    echo "  enable: ${TUN_ENABLE}"
    echo "  stack: mixed"
    echo "  auto-route: true"
    echo "  auto-redirect: true"
    echo "  auto-detect-interface: true"
    echo "  device: miproxy"
    echo "  mtu: 1500"
    echo "  dns-hijack: [\"any:53\", \"tcp://any:53\"]"
    echo "  strict-route: true"
    echo "  gso: true"
    echo "  gso-max-size: 65536"
    # 来自订阅源的字段
    [ -n "${SUB_PROXIES}" ] && echo "# 节点列表（来自订阅源）" && echo "${SUB_PROXIES}"
    [ -n "${SUB_HOSTS}" ] && echo "# hosts（来自订阅源）" && echo "${SUB_HOSTS}"

    if [ -n "${SUB_PG}" ]; then
        echo "# 代理组（来自订阅源）"
        echo "${SUB_PG}"
    else
        echo "proxy-groups:"
        echo "  - name: PROXY"
        echo "    type: select"
        echo "    proxies: [DIRECT, REJECT]"
    fi

    if [ -n "${SUB_RULES}" ]; then
        echo "# 路由规则（来自订阅源）"
        echo "${SUB_RULES}"
    else
        echo "rules: [\"GEOIP,CN,DIRECT\", \"MATCH,PROXY\"]"
    fi

    if [ -n "${SUB_DNS}" ]; then
        echo "# DNS（来自订阅源）"
        echo "${SUB_DNS}"
    else
        echo "dns:"
        echo "  enable: true"
        echo "  listen: 0.0.0.0:53"
        echo "  enhanced-mode: fake-ip"
        echo "  fake-ip-range: 198.18.0.1/16"
        if [ -n "${SUB_DOMAIN_FILTER}" ]; then
            echo "  fake-ip-filter:"
            echo -e "    - \"+.lan\""
            echo -e "    - \"+.local\""
            echo -e "${SUB_DOMAIN_FILTER}"
        else
            echo "  fake-ip-filter:"
            echo "    - \"+.lan\""
            echo "    - \"+.local\""
        fi
        echo "  nameserver:"
        echo "    - 223.5.5.5"
        echo "    - 119.29.29.29"
        echo "    - 8.8.8.8"
    fi

    [ -n "${SUB_BYPASS}" ] && echo "# bypass 私有绕过列表" && echo "${SUB_BYPASS}"
    [ -n "${SUB_PROXY_PROVIDERS}" ] && echo "# proxy-providers 代理集合" && echo "${SUB_PROXY_PROVIDERS}"
    [ -n "${SUB_RULE_PROVIDERS}" ] && echo "# rule-providers 规则集合" && echo "${SUB_RULE_PROVIDERS}"
    [ -n "${SUB_SUB_RULE}" ] && echo "# sub-rule 子规则" && echo "${SUB_SUB_RULE}"
    [ -n "${SUB_TUNNELS}" ] && echo "# tunnels 流量隧道" && echo "${SUB_TUNNELS}"
    [ -n "${SUB_LISTENERS}" ] && echo "# listeners 监听器" && echo "${SUB_LISTENERS}"
    [ -n "${SUB_SNIFF}" ] && echo "# sniff 嗅探" && echo "${SUB_SNIFF}"
    [ -n "${SUB_NTP}" ] && echo "# ntp 时间同步" && echo "${SUB_NTP}"
    [ -n "${SUB_SCRIPT}" ] && echo "# script 脚本" && echo "${SUB_SCRIPT}"
} > "${CONFIG_TMP}"

# ⚠️ 先写临时文件、回读校验节点数，再落位：
# 「卸载保留数据 → 重新安装」时数据目录里可能还留着上一份能用的 config.yaml，
# 绝不能被一份 0 节点的配置盖掉（内核一起就没节点可用了）。
# ⚠️ 判定条件是「订阅里本来就有内联节点、生成结果却一个都没有」——
#    proxy-providers 型订阅本来就没有内联节点（节点由 provider 运行时拉取），
#    不能被当成失败。
CONFIG_NODE_COUNT=$(count_yaml_nodes "${CONFIG_TMP}")
if [ "${SUB_INLINE_NODES:-0}" -gt 0 ] 2>/dev/null && [ "${CONFIG_NODE_COUNT:-0}" -eq 0 ] 2>/dev/null; then
    if [ -f "${CONFIG_FILE}" ] && [ "$(count_yaml_nodes "${CONFIG_FILE}")" -gt 0 ] 2>/dev/null; then
        rm -f "${CONFIG_TMP}"
        log_msg "  ❌ 新生成的 config.yaml 里一个节点都没有 → 保留原有配置（其中仍有可用节点）"
        log_msg "  ⚠️ 订阅未生效，请在管理界面「订阅」页重新应用配置"
    else
        mv -f "${CONFIG_TMP}" "${CONFIG_FILE}"
        log_msg "  ⚠️ 订阅未解析出任何节点，生成的 config.yaml 里没有节点"
    fi
else
    mv -f "${CONFIG_TMP}" "${CONFIG_FILE}"
fi
chmod 666 "${CONFIG_FILE}"
log_msg "✅ config.yaml 已生成（内联节点 ${CONFIG_NODE_COUNT:-0} 个）"

rm -f "${VAR_DIR}/base.yaml" "${VAR_DIR}/subscription.yaml" "${VAR_DIR}/subscription.conf"

# settings.conf 下面会整体重写，未列出的键会被丢弃。
# wizard_admin_port / wizard_admin_token 不在向导字段里（由管理界面或手动维护），必须显式保留，
# 否则「卸载时保留数据 → 重新安装」会把管理端口/令牌改回默认值。
ADMIN_PORT_KEEP=""
ADMIN_TOKEN_KEEP=""
if [ -f "${TRIM_PKGETC}/settings.conf" ]; then
    ADMIN_PORT_KEEP=$(grep '^wizard_admin_port=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
    ADMIN_TOKEN_KEEP=$(grep '^wizard_admin_token=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
fi

{
    echo "wizard_http_port=${HTTP_PORT}"
    echo "wizard_api_port=${API_PORT}"
    echo "wizard_tun_enable=${TUN_ENABLE}"
    echo "wizard_sub_type=${SUB_TYPE}"
    echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
    [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
    [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
    [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
    [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
    [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
    [ -n "${ADMIN_PORT_KEEP}" ] && echo "wizard_admin_port=${ADMIN_PORT_KEEP}"
    [ -n "${ADMIN_TOKEN_KEEP}" ] && echo "wizard_admin_token=${ADMIN_TOKEN_KEEP}"
} > "${TRIM_PKGETC}/settings.conf"
chmod 666 "${TRIM_PKGETC}/settings.conf" 2>/dev/null

