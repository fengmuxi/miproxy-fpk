#!/bin/bash
#
# MiProxy 升级后回调
# 功能：升级完成后启动服务
#

set +e

LOG_FILE="${TRIM_PKGVAR}/upgrade_callback.log"
mkdir -p "$(dirname "${LOG_FILE}")"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg "upgrade_callback: 升级完成，启动服务..."

# 面板文件「先删后拷」整体重置到数据目录：升级 .fpk 只更新安装目录，
# 数据目录（唯一稳定路径）里的 ui/ 若不重置，会被内核 /upgrade/ui 留下的
# MetaCubeXD 残留污染（sw.js / _nuxt / workbox-* 等叠加覆盖清不掉），
# 浏览器 Service Worker 还会继续钉住旧文件 —— 表现为「升级了但面板没恢复」。
# sync_ui.sh 带备份与回滚；脚本本身由 main 的 sync_cmd_scripts 同步进数据目录，
# 这里优先用同步后的副本，回退到本脚本同目录。
SYNC_UI=""
for p in "${TRIM_PKGVAR}/cmd/sync_ui.sh" "${SCRIPT_DIR}/sync_ui.sh" \
         "${TRIM_APPDEST}/cmd/sync_ui.sh" "/var/apps/miproxy/cmd/sync_ui.sh" \
         "/var/packages/miproxy/cmd/sync_ui.sh"; do
    if [ -f "${p}" ]; then SYNC_UI="${p}"; break; fi
done
if [ -n "${SYNC_UI}" ]; then
    if bash "${SYNC_UI}" >>"${LOG_FILE}" 2>&1; then
        log_msg "upgrade_callback: 面板文件已重置到数据目录"
    else
        log_msg "upgrade_callback: 警告 - 面板重置失败（详见 sync_ui.log），管理界面「更新」页可手动修复"
    fi
else
    log_msg "upgrade_callback: 警告 - 未找到 sync_ui.sh，跳过面板重置"
fi

bash "${SCRIPT_DIR}/main" start 2>>"${LOG_FILE}" || true

log_msg "upgrade_callback: 升级完成，服务已启动"
exit 0
