#!/bin/bash
#
# MiProxy 升级后回调
# 功能：升级完成后启动服务
#

set +e

LOG_FILE="${TRIM_PKGVAR}/upgrade_callback.log"
mkdir -p "$(dirname "${LOG_FILE}")"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg "upgrade_callback: 升级完成，启动服务..."

# 同步新版 UI 与运行期脚本进数据目录。
# 管理服务/网关优先从 ${TRIM_PKGVAR}/cmd、${TRIM_PKGVAR}/ui 启动（数据目录是
# 唯一稳定路径），若不比对同步，升级 .fpk 只更新安装目录，页面与脚本会一直
# 是旧版（「升级了但管理页没有新功能」的成因）。main start 里的 sync_cmd_scripts
# 会同步 cmd/；UI 需要在这里单独比对拷贝。
APP_DEST="${TRIM_APPDEST}"
UI_TARGET="${TRIM_PKGVAR}/ui"
if [ -d "${APP_DEST}/ui" ]; then
    for _sub in zashboard metacubexd admin; do
        [ -d "${APP_DEST}/ui/${_sub}" ] || continue
        mkdir -p "${UI_TARGET}/${_sub}" 2>/dev/null
        cp -rf "${APP_DEST}/ui/${_sub}/"* "${UI_TARGET}/${_sub}/" 2>/dev/null
        log_msg "upgrade_callback: 已同步 ui/${_sub} 到数据目录"
    done
    for _f in index.html frame-zashboard.html frame-metacubexd.html config; do
        [ -f "${APP_DEST}/ui/${_f}" ] && cp -f "${APP_DEST}/ui/${_f}" "${UI_TARGET}/${_f}" 2>/dev/null
    done
fi

bash "${SCRIPT_DIR}/main" start 2>>"${LOG_FILE}" || true

log_msg "upgrade_callback: 升级完成，服务已启动"
exit 0
